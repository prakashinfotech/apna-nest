# Backend Environment Variables
# Copy this file and rename to set environment-specific values.
# For local development, use `dotnet user-secrets` or override in appsettings.Development.json.

# Supabase PostgreSQL connection string
# Get these from your Supabase project: Settings > Database > Connection string (URI)
ConnectionStrings__DefaultConnection=Host=YOUR_SUPABASE_HOST;Port=6543;Database=postgres;Username=YOUR_SUPABASE_USER;Password=YOUR_PASSWORD;Ssl Mode=Require;Trust Server Certificate=true;No Reset On Close=true;Command Timeout=30;

# JWT secret for authentication tokens (min 64 characters recommended)
JwtSettings__Secret=CHANGE_ME_use_a_64_char_secret_for_hmac_sha256_in_production_env
